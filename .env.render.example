# OANDA v3 Bot — Render Deployment Environment Variables
# Copy these to Render Dashboard → Environment

# OANDA Configuration
OANDA_ENVIRONMENT=practice
OANDA_API_TOKEN=your_oanda_api_token_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here

# Trading Parameters
RISK_PERCENT=3
TP_MULTIPLIER=2
SL_MULTIPLIER=1
CANDLE_PERIOD=300
MAX_CONCURRENT_TRADES=5

# Database
DATABASE_URL=postgresql://user:password@host:5432/oanda_bot

# Authentication & Security
JWT_SECRET=generate_with_node_crypto_randomBytes_32
VITE_APP_ID=your_manus_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# Application
VITE_APP_TITLE=OANDA v3 Bot
NODE_ENV=production

# Optional: Manus Built-in APIs (if using)
BUILT_IN_FORGE_API_KEY=your_forge_api_key
BUILT_IN_FORGE_API_URL=https://api.manus.im
VITE_FRONTEND_FORGE_API_KEY=your_frontend_forge_key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im
VITE_ANALYTICS_ENDPOINT=https://analytics.manus.im
VITE_ANALYTICS_WEBSITE_ID=your_website_id
